{
  "name": "spotify-savedw-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build --mode prod",
    "build-no-check": "vite build --mode prod",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "preview": "vite preview",
    "generate-api": "openapi --input http://localhost:8000/openapi.json --output ./src/api/client --client fetch",
    "test-ct": "playwright test -c tests/playwright-ct.config.ts",
    "test-unit": "vitest run unit",
    "test-unit-watch": "vitest unit",
    "tests-codegen": "pnpm exec playwright codegen localhost:3000"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tanstack/react-query": "^5.90.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "jotai": "^2.16.1",
    "lucide-react": "^0.513.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-error-boundary": "^6.0.2",
    "react-hook-form": "^7.70.0",
    "react-router": "^7.12.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.177.0",
    "universal-cookie": "^7.2.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@playwright/experimental-ct-react": "^1.57.0",
    "@types/node": "^24.10.4",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.177.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.23",
    "openapi-typescript-codegen": "^0.27.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-glsl": "^1.5.5",
    "vitest": "^4.0.16"
  }
}
